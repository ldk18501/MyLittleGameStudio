{
  "schemaVersion": "1.0",
  "gates": {
    "project-selected": {
      "approval": "projectSelected",
      "all": [
        ".mlgs/project.md"
      ]
    },
    "concept-approved": {
      "approval": "conceptPackage",
      "all": [
        "design/concept-package.md",
        "design/reference-analysis.md",
        "design/art/visual-target.json"
      ]
    },
    "plan-approved": {
      "approval": "designTechPlan",
      "all": [
        "design/systems/*.md",
        "design/content-architecture.json",
        "design/player-journey.md",
        "design/onboarding.md",
        "docs/tech-plan.md",
        "production/task-plan.md",
        "production/data/configuration-plan.md",
        "production/release/operations-readiness.md",
        "production/scope/release-scope.json",
        "design/art/style-bible.md",
        "production/assets/asset-manifest.json",
        "design/game-profile.json",
        "design/ui/screen-inventory.json",
        "design/baseline.json",
        "production/capabilities/capability-manifest.json",
        "design/art/visual-scene-contract.json",
        "design/framework-adoption.json",
        "design/presentation-architecture.json",
        "design/code/codebase-profile.json",
        "design/code/module-map.json"
      ],
      "artManifest": {
        "path": "production/assets/asset-manifest.json",
        "requiredFor": "release",
        "minimumStatus": "planned"
      },
      "scopeManifest": {
        "path": "production/scope/release-scope.json",
        "requiredFor": "release",
        "minimumStatus": "specified",
        "requiredTypes": [
          "feature",
          "content",
          "tutorial",
          "ui-screen",
          "configuration",
          "audio",
          "art",
          "localization",
          "operations",
          "build"
        ]
      },
      "gameProfileCoverage": {
        "profilePath": "design/game-profile.json",
        "scopePath": "production/scope/release-scope.json",
        "uiScreenPath": "design/ui/screen-inventory.json"
      },
      "designBaseline": {
        "path": "design/baseline.json"
      },
      "uiScreenContract": {
        "path": "design/ui/screen-inventory.json",
        "requiredFor": "content-complete",
        "minimumStatus": "planned"
      },
      "visualSceneContract": {
        "path": "design/art/visual-scene-contract.json",
        "requiredFor": "vertical-slice",
        "minimumStatus": "specified"
      },
      "frameworkAdoption": {
        "path": "design/framework-adoption.json"
      },
      "presentationArchitecture": {
        "path": "design/presentation-architecture.json",
        "contractOnly": true
      },
      "contentArchitecture": {
        "path": "design/content-architecture.json"
      },
      "codebaseUnderstanding": {
        "profilePath": "design/code/codebase-profile.json",
        "moduleMapPath": "design/code/module-map.json"
      }
    },
    "prototype-passed-or-skipped": {
      "approval": "prototypeValidation",
      "all": [
        "prototype/prototype-plan.md",
        "prototype/playtest-report.md"
      ],
      "allowSkippedWithRisk": true
    },
    "production-unblocked": {
      "approval": "productionUnblocked",
      "all": [
        "production/task-plan.md"
      ]
    },
    "vertical-slice-approved": {
      "all": [
        "production/quality/vertical-slice.json",
        "production/quality/code-audit.json",
        "production/assets/asset-manifest.json",
        "production/scope/release-scope.json"
      ],
      "qualityReport": {
        "path": "production/quality/vertical-slice.json",
        "stage": "vertical-slice",
        "requiredChecks": [
          "core-loop",
          "final-look-target",
          "visual-target-match",
          "first-session-flow",
          "ui-flow",
          "art-pipeline",
          "data-driven-config",
          "audio-feedback",
          "performance-budget",
          "code-modularity",
